# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# =========================
# FastAPI / Python Server
# =========================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
venv/
.venv/
env/
.env/
pip-log.txt
pip-delete-this-directory.txt

# Testing and Coverage (Python)
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml

# Type checking & Linting
.mypy_cache/
.ruff_cache/
.pyre/

# Database / SQLite (Common for local FastAPI dev)
*.sqlite3
*.db

# FastAPI / Uvicorn specific (if logging locally)
*.log